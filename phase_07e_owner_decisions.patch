+                                          <ExternalLink className="w-3.5 h-3.5 me-1 text-muted-foreground" />
+                                          {t("shiftA")}
+                                        </Link>
+                                      }
+                                      className="h-7 px-2 text-[11px]"
+                                    />
+                                    <Button
+                                      variant="ghost"
+                                      size="sm"
+                                      render={
+                                        <Link href={orderLinkB} target="_blank">
+                                          <ExternalLink className="w-3.5 h-3.5 me-1 text-muted-foreground" />
+                                          {t("shiftB")}
+                                        </Link>
+                                      }
+                                      className="h-7 px-2 text-[11px]"
+                                    />
+                                  </div>
+                                </td>
+                              </tr>
+                            );
+                          })}
+                        </tbody>
+                      </table>
+                    </div>
+                  </div>
+                ))}
+              </div>
+            )}
+          </div>
+        )}
+      </CardContent>
+    </Card>
+  );
+}
