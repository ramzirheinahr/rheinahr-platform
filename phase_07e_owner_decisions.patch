+                onChange={(e) => setProposeReason(e.target.value)}
+                placeholder={t("notesPlaceholder")}
+                className="text-xs h-16 resize-none"
+              />
+            </div>
+          </div>
+
+          <DialogFooter className="gap-2">
+            <Button
+              variant="outline"
+              size="sm"
+              onClick={() => setIsProposing(false)}
