+                                  </span>
+                                </td>
+
+                                {/* Quick Links Action */}
+                                <td className="p-3 align-top text-end whitespace-nowrap">
+                                  <div className="flex flex-col items-end gap-1">
+                                    <Button
+                                      variant="ghost"
+                                      size="sm"
+                                      render={
