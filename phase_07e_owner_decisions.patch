+            >
+              {isPending ? <Loader2 className="size-3.5 animate-spin mr-1" /> : null}
+              {t("proposeCorrectionBtn")}
+            </Button>
+          </DialogFooter>
+        </DialogContent>
+      </Dialog>
+    </>
+  );
+}
