+  const dayOfWeek = d22.getUTCDay(); // 0 = Sun, 1 = Mon, 2 = Tue, 3 = Wed, 4 = Thu, 5 = Fri, 6 = Sat
+  const diffToWednesday = (dayOfWeek - 3 + 7) % 7;
+  const day = 22 - diffToWednesday;
+  return formatIso(year, 11, day);
