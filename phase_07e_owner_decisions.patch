+  const paymentTermsDays =
+    typeof s.paymentTermsDays === "number" && !isNaN(s.paymentTermsDays) && s.paymentTermsDays > 0
+      ? s.paymentTermsDays
+      : typeof clientObj?.paymentTermsDays === "number" && !isNaN(clientObj.paymentTermsDays) && clientObj.paymentTermsDays > 0
+      ? clientObj.paymentTermsDays
+      : null;
+
+  if (paymentTermsDays === null) {
+    return null;
+  }
+
+  return {
+    id: (clientObj && typeof clientObj.id === "string" ? clientObj.id : null) || (typeof s.clientId === "string" ? s.clientId : "c-hist"),
+    facilityName: facility,
+    address,
+    billingEmail,
+    billingInfo,
+    shortCode,
+    internalNumber,
+    paymentTermsDays,
+    hourlyRates: {},
+    surchargeSat: 0,
+    surchargeSun: 0,
+    surchargeHoliday: 0,
+    surchargeNight: 0,
+    nightStart: "22:00",
+    nightEnd: "06:00",
+  };
+}
+
+export type StoredHistoricalPdfVerificationResult =
+  | { reliable: true; buffer: Buffer; sha256: string; byteLength: number }
+  | {
+      reliable: false;
+      status: 409 | 422;
+      reason: string;
+      errorCode: "UNVERIFIED_STORED_FILE" | "CHECKSUM_MISMATCH" | "SIZE_MISMATCH" | "FILE_MISSING_OR_CORRUPT";
+    };
+
+/**
+ * Strict Verification of Stored Historical PDF Files (Option A Reliability Standard)
+ *
+ * Enforces that a designated stored PDF path on disk is only served as authentic
+ * if its checksum and byte length match a pre-registered reference checksum in snapshot/provenance.
+ * Files lacking registered reference checksums are classified as UNVERIFIED_STORED_FILE and fail closed (422).
+ */
+export async function verifyStoredHistoricalPdf(
+  storedPdfPath: string,
+  snapshotData: unknown,
+  verifier: FileVerifier = defaultFileVerifier
+): Promise<StoredHistoricalPdfVerificationResult> {
+  const snap = snapshotData && typeof snapshotData === "object" ? (snapshotData as Record<string, unknown>) : null;
+
+  // Retrieve pre-recorded reference checksum & byteLength from trusted snapshot / archival metadata
+  const storedInfo = snap?.storedPdfInfo && typeof snap.storedPdfInfo === "object" ? (snap.storedPdfInfo as Record<string, unknown>) : null;
+  const archivedRecord = snap?.archivedPdfRecord && typeof snap.archivedPdfRecord === "object" ? (snap.archivedPdfRecord as Record<string, unknown>) : null;
+
+  const expectedSha256 =
+    (typeof storedInfo?.sha256 === "string" && storedInfo.sha256.trim()) ||
+    (typeof archivedRecord?.sha256 === "string" && archivedRecord.sha256.trim()) ||
+    (typeof snap?.pdfSha256 === "string" && snap.pdfSha256.trim()) ||
+    (typeof snap?.pdfChecksum === "string" && snap.pdfChecksum.trim()) ||
+    (typeof snap?.sha256 === "string" && snap.sha256.trim()) ||
+    null;
+
+  const expectedByteLength =
+    (typeof storedInfo?.byteLength === "number" && storedInfo.byteLength) ||
+    (typeof archivedRecord?.byteLength === "number" && archivedRecord.byteLength) ||
+    (typeof snap?.pdfByteLength === "number" && snap.pdfByteLength) ||
+    null;
+
+  const check = await verifier(storedPdfPath);
+  if (!check.exists || !check.buffer || !check.sha256 || !check.byteLength) {
+    return {
+      reliable: false,
+      status: 422,
+      errorCode: "FILE_MISSING_OR_CORRUPT",
+      reason: `Das hinterlegte historische Rechnungsdokument ist nicht verfügbar oder beschädigt. (${check.reason || "Datei nicht lesbar"})`,
+    };
+  }
+
+  // If no reference checksum is registered in historical metadata, the existing file cannot be proven authentic
+  if (!expectedSha256) {
+    return {
+      reliable: false,
+      status: 422,
+      errorCode: "UNVERIFIED_STORED_FILE",
+      reason:
+        "Das hinterlegte historische Rechnungsdokument besitzt keine registrierte Prüfsumme (unverified stored file) und kann nicht als verlässliches Originaldokument ausgegeben werden. Bitte prüfen Sie das Buchhaltungsarchiv.",
+    };
+  }
+
+  if (check.sha256 !== expectedSha256) {
+    return {
+      reliable: false,
+      status: 409,
+      errorCode: "CHECKSUM_MISMATCH",
+      reason: `Das hinterlegte historische Rechnungsdokument wurde auf dem Server verändert oder stimmt nicht mit der registrierten Prüfsumme überein (Checksum-Mismatch: erwartet ${expectedSha256}, vorgefunden ${check.sha256}).`,
+    };
+  }
+
+  if (expectedByteLength && check.byteLength !== expectedByteLength) {
+    return {
+      reliable: false,
+      status: 409,
+      errorCode: "SIZE_MISMATCH",
+      reason: `Das hinterlegte historische Rechnungsdokument hat eine abweichende Dateigröße (Größen-Mismatch: erwartet ${expectedByteLength} Bytes, vorgefunden ${check.byteLength} Bytes).`,
+    };
+  }
+
+  return {
+    reliable: true,
+    buffer: check.buffer,
+    sha256: check.sha256,
+    byteLength: check.byteLength,
+  };
+}
+
+export async function checkReliableHistoricalOrigin(
+  invoice: {
+    id: string;
+    invoiceNumber?: string;
+    pdfUrl?: string | null;
+    snapshotData?: unknown;
+    netAmount?: number;
+    vatAmount?: number;
+    grossAmount?: number;
+    date?: Date | string;
+    client?: { facilityName?: string; address?: string | null } | null;
+  },
+  fileVerifier?: FileVerifier
+): Promise<{
+  reliable: boolean;
+  source: "stored_pdf" | "frozen_snapshot" | "none";
+  reason?: string;
+  storedPdfInfo?: {
+    path: string;
+    sha256: string;
+    byteLength: number;
+  };
+  frozenSnapshotSha256?: string;
+  hasKnownRoundingDiscrepancy?: boolean;
+  knownRoundingDiscrepancyCents?: number;
+  pdfByteLength?: number;
+}> {
+  const candidatePdfUrl = resolveStoredPdfCandidatePath(invoice);
+
+  if (candidatePdfUrl) {
+    const verifier = fileVerifier || defaultFileVerifier;
+    const fileCheck = await verifier(candidatePdfUrl);
+    if (fileCheck.exists && fileCheck.sha256 && fileCheck.byteLength) {
+      return {
+        reliable: true,
+        source: "stored_pdf",
+        storedPdfInfo: {
+          path: fileCheck.realPath || candidatePdfUrl,
+          sha256: fileCheck.sha256,
+          byteLength: fileCheck.byteLength,
+        },
+      };
+    }
+  }
+
+  const snapshotCheck = await isCompleteFrozenSnapshot(invoice.snapshotData, invoice);
+  if (snapshotCheck.complete) {
+    return {
+      reliable: true,
+      source: "frozen_snapshot",
+      frozenSnapshotSha256: snapshotCheck.sha256,
+      hasKnownRoundingDiscrepancy: snapshotCheck.hasKnownRoundingDiscrepancy,
+      knownRoundingDiscrepancyCents: snapshotCheck.knownRoundingDiscrepancyCents,
+      pdfByteLength: snapshotCheck.pdfByteLength,
+    };
+  }
+
+  const failureReason = candidatePdfUrl
+    ? `Die angegebene PDF-Datei "${candidatePdfUrl}" existiert nicht auf dem Server, liegt außerhalb des sicheren Speichers oder konnte nicht verifiziert werden, und es liegen keine vollständigen eingefrorenen Snapshot-Posten vor.`
+    : (snapshotCheck.reason || "Die Rechnung verfügt weder über eine verifizierte gespeicherte PDF-Datei noch über einen vollständigen eingefrorenen Snapshot.");
+
+  return {
+    reliable: false,
+    source: "none",
+    reason: failureReason,
+  };
+}
+
+export async function hasReliableHistoricalOrigin(invoice: {
+  id?: string;
+  pdfUrl?: string | null;
+  snapshotData?: unknown;
+  netAmount?: number;
+  grossAmount?: number;
+  date?: Date | string;
+  client?: { facilityName?: string; address?: string | null } | null;
+}): Promise<{ reliable: boolean; source: "stored_pdf" | "frozen_snapshot" | "none"; reason?: string }> {
+  const defaultCheck = await isCompleteFrozenSnapshot(invoice.snapshotData, invoice);
+  if (defaultCheck.complete) {
+    return { reliable: true, source: "frozen_snapshot" };
+  }
+  const rawUrl = resolveStoredPdfCandidatePath(invoice);
+  if (typeof rawUrl === "string" && rawUrl.trim().length > 0) {
+    const fileCheck = defaultFileVerifier(rawUrl.trim());
+    if (fileCheck.exists) {
+      return { reliable: true, source: "stored_pdf" };
+    }
+  }
+  return {
+    reliable: false,
+    source: "none",
+    reason: defaultCheck.reason || "Weder verifizierte Datei noch vollständiger Snapshot vorhanden.",
+  };
+}
+
+export type InvoiceRevisionState = {
+  mode: "legacy_initial" | "successive";
+  baseRevisionNumber: number;
+  targetRevisionNumber: number;
+  revisions: Array<{ id: string; revisionNumber: number }>;
+};
+
+export async function determineInvoiceRevisionState(
+  invoice: { id: string; invoiceNumber: string; snapshotData?: unknown },
+  // eslint-disable-next-line @typescript-eslint/no-explicit-any
+  dbOrTx: any
+): Promise<InvoiceRevisionState> {
+  // eslint-disable-next-line @typescript-eslint/no-explicit-any
+  const snap = invoice.snapshotData as any;
+  const isV2 = isV2CalculationVersion(snap);
+
+  let revisions: Array<{ id: string; revisionNumber: number }> = [];
+  if (dbOrTx.invoiceRevision && typeof dbOrTx.invoiceRevision.findMany === "function") {
+    revisions = await dbOrTx.invoiceRevision.findMany({
+      where: { invoiceId: invoice.id },
+      select: { id: true, revisionNumber: true },
+      orderBy: { revisionNumber: "asc" },
+    });
+  } else if (dbOrTx.invoiceRevision && typeof dbOrTx.invoiceRevision.count === "function") {
+    const count = await dbOrTx.invoiceRevision.count({ where: { invoiceId: invoice.id } });
+    revisions = Array.from({ length: count }, (_, i) => ({ id: `rev-${i + 1}`, revisionNumber: i + 1 }));
+  }
+
+  const revisionCount = revisions.length;
+
+  // Case 1: Freshly issued V2 invoice without revision history -> Strictly IMMUTABLE
+  if (isV2 && revisionCount === 0) {
+    throw new FreshV2InvoiceImmutableError(invoice.invoiceNumber);
+  }
+
+  // Case 2: Legacy invoice entering Phase 6 refresh for the first time
+  if (!isV2 && revisionCount === 0) {
+    return {
+      mode: "legacy_initial",
+      baseRevisionNumber: 0,
+      targetRevisionNumber: 1,
+      revisions: [],
+    };
+  }
+
+  // Case 3: Successive revisions (Rev 1 -> Rev 2, Rev 2 -> Rev 3)
+  if (revisionCount > 0) {
+    if (!isV2) {
+      throw new RevisionChainCorruptedError(
+        `[REVISION_CHAIN_CORRUPTED] Rechnung "${invoice.invoiceNumber}" hat ${revisionCount} Revisionen, aber der Snapshot weist keine gültige V2-Berechnung auf.`
+      );
+    }
+
+    // Verify monotonic sequencing: 1, 2, 3...
+    for (let i = 0; i < revisions.length; i++) {
+      if (revisions[i].revisionNumber !== i + 1) {
+        throw new RevisionChainCorruptedError(
+          `[REVISION_CHAIN_CORRUPTED] Lücke oder Inkonsistenz in der Revisionskette von Rechnung "${invoice.invoiceNumber}": Revision ${i + 1} erwartet, aber ${revisions[i].revisionNumber} gefunden.`
+        );
+      }
+    }
+
+    const highestRevisionNumber = revisions[revisions.length - 1].revisionNumber;
+    const snapRevisionNumber = Number(snap?.revisionNumber);
+
+    if (isNaN(snapRevisionNumber) || snapRevisionNumber !== highestRevisionNumber) {
+      throw new RevisionChainCorruptedError(
+        `[REVISION_CHAIN_CORRUPTED] Inkonsistenz in der Revisionskette von Rechnung "${invoice.invoiceNumber}": Revisionsnummer im Snapshot (${snap?.revisionNumber}) stimmt nicht mit der höchsten gespeicherten Revision (${highestRevisionNumber}) überein.`
+      );
+    }
+
+    return {
+      mode: "successive",
+      baseRevisionNumber: highestRevisionNumber,
+      targetRevisionNumber: highestRevisionNumber + 1,
+      revisions,
+    };
+  }
+
+  throw new RevisionChainCorruptedError(
+    `[REVISION_CHAIN_CORRUPTED] Unbekannter Revisionszustand für Rechnung "${invoice.invoiceNumber}".`
+  );
+}
