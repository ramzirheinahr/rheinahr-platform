+import { describe, expect, it } from "vitest";
+import {
+  CALCULATION_VERSIONS,
+  isLegacyCalculationVersion,
+  isV2CalculationVersion,
+  resolveInvoiceCalculationVersion,
+} from "./invoice-calculation-version";
+
+describe("invoice-calculation-version helper", () => {
+  it("classifies complete absence of snapshot (null or undefined) as legacy-v1 without explicit tag", () => {
+    expect(resolveInvoiceCalculationVersion(null)).toEqual({
+      status: "resolved",
+      version: "legacy-v1",
+      isLegacy: true,
+      isExplicit: false,
+    });
+
+    expect(resolveInvoiceCalculationVersion(undefined)).toEqual({
+      status: "resolved",
+      version: "legacy-v1",
+      isLegacy: true,
+      isExplicit: false,
+    });
+
+    expect(isLegacyCalculationVersion(null)).toBe(true);
+    expect(isLegacyCalculationVersion(undefined)).toBe(true);
+    expect(isV2CalculationVersion(null)).toBe(false);
+    expect(isV2CalculationVersion(undefined)).toBe(false);
+  });
+
+  it("classifies valid record without calculationVersion or with calculationVersion === undefined as legacy-v1 without explicit tag", () => {
+    expect(resolveInvoiceCalculationVersion({})).toEqual({
+      status: "resolved",
+      version: "legacy-v1",
+      isLegacy: true,
+      isExplicit: false,
+    });
+
+    expect(resolveInvoiceCalculationVersion({ items: [] })).toEqual({
+      status: "resolved",
+      version: "legacy-v1",
+      isLegacy: true,
+      isExplicit: false,
+    });
+
+    expect(resolveInvoiceCalculationVersion({ calculationVersion: undefined })).toEqual({
+      status: "resolved",
+      version: "legacy-v1",
+      isLegacy: true,
+      isExplicit: false,
+    });
+
+    expect(isLegacyCalculationVersion({})).toBe(true);
+    expect(isLegacyCalculationVersion({ calculationVersion: undefined })).toBe(true);
+    expect(isV2CalculationVersion({})).toBe(false);
+    expect(isV2CalculationVersion({ calculationVersion: undefined })).toBe(false);
+  });
+
+  it("recognizes explicit legacy-v1 tag", () => {
+    const res = resolveInvoiceCalculationVersion({
+      calculationVersion: CALCULATION_VERSIONS.LEGACY_V1,
+    });
+
+    expect(res).toEqual({
+      status: "resolved",
+      version: "legacy-v1",
+      isLegacy: true,
+      isExplicit: true,
+    });
+    expect(isLegacyCalculationVersion({ calculationVersion: "legacy-v1" })).toBe(true);
+    expect(isV2CalculationVersion({ calculationVersion: "legacy-v1" })).toBe(false);
+  });
+
+  it("recognizes explicit v2 tag as reserved without activating calculation", () => {
+    const res = resolveInvoiceCalculationVersion({
+      calculationVersion: CALCULATION_VERSIONS.V2,
+    });
+
+    expect(res).toEqual({
+      status: "resolved",
+      version: "v2",
+      isLegacy: false,
+      isExplicit: true,
+    });
+    expect(isLegacyCalculationVersion({ calculationVersion: "v2" })).toBe(false);
+    expect(isV2CalculationVersion({ calculationVersion: "v2" })).toBe(true);
+  });
+
+  it("classifies explicit null, empty string, whitespace-only, or unknown tags as unsupported", () => {
+    const corruptTagCases = [
+      null,
+      "",
+      "   ",
+      "\t",
+      "v3",
+      "v1",
+      "legacy",
+      123,
+      true,
+      false,
+      { nested: "version" },
+      ["legacy-v1"],
+    ];
+
+    for (const tag of corruptTagCases) {
+      const res = resolveInvoiceCalculationVersion({ calculationVersion: tag });
+      expect(res).toEqual({
+        status: "unsupported",
+        rawVersion: tag,
+        isLegacy: false,
+      });
+      expect(isLegacyCalculationVersion({ calculationVersion: tag })).toBe(false);
+      expect(isV2CalculationVersion({ calculationVersion: tag })).toBe(false);
+    }
+  });
+
+  it("classifies non-null snapshot of invalid structure (primitives, arrays) as unsupported", () => {
+    const invalidStructures = [
+      "broken-json-string",
+      12345,
+      true,
+      false,
+      [],
+      ["item1"],
+      [{ calculationVersion: "legacy-v1" }],
+    ];
+
+    for (const invalid of invalidStructures) {
+      const res = resolveInvoiceCalculationVersion(invalid);
+      expect(res).toEqual({
+        status: "unsupported",
+        rawVersion: invalid,
+        isLegacy: false,
+      });
+      expect(isLegacyCalculationVersion(invalid)).toBe(false);
+      expect(isV2CalculationVersion(invalid)).toBe(false);
+    }
+  });
+
+  it("never infers calculation version from invoice dates, amounts, status, or emailSent", () => {
+    const historicalSnapshotWithIndicators = {
+      date: "2026-10-08",
+      netAmount: 1500,
+      status: "paid",
+      emailSent: { sentAt: "2026-10-08T10:00:00Z" },
+    };
+
+    const res = resolveInvoiceCalculationVersion(historicalSnapshotWithIndicators);
+    expect(res).toEqual({
+      status: "resolved",
+      version: "legacy-v1",
+      isLegacy: true,
+      isExplicit: false,
+    });
+    expect(isLegacyCalculationVersion(historicalSnapshotWithIndicators)).toBe(true);
+    expect(isV2CalculationVersion(historicalSnapshotWithIndicators)).toBe(false);
+  });
+});
diff --git a/lib/invoice-calculation-version.ts b/lib/invoice-calculation-version.ts
new file mode 100644
index 0000000..70cd6b1
--- /dev/null
+++ b/lib/invoice-calculation-version.ts
@@ -0,0 +1,123 @@
+/**
+ * Invoice Calculation Version Helper
+ * 
+ * Defines and resolves the calculation engine version used for an invoice.
+ * Phase 1 rules:
+ * - Absence of snapshot entirely (null or undefined): resolved as 'legacy-v1' (isExplicit: false).
+ * - Valid record without calculationVersion or with calculationVersion === undefined: resolved as 'legacy-v1' (isExplicit: false).
+ * - Explicit 'legacy-v1': resolved as 'legacy-v1' (isExplicit: true).
+ * - Explicit 'v2': resolved as 'v2' (reserved, isExplicit: true, isLegacy: false).
+ * - Explicit null, "", whitespace-only, unknown strings, or invalid types for calculationVersion: status 'unsupported' (isLegacy: false).
+ * - Non-null snapshot of invalid structure (primitives, arrays): status 'unsupported' (isLegacy: false).
+ * - In all 'unsupported' cases, both isLegacy and isV2 return false.
+ * - Calculation version is NEVER inferred from invoice dates, amounts, status, or emailSent flags.
+ */
+
+export type InvoiceCalculationVersion = "legacy-v1" | "v2";
+
+export const CALCULATION_VERSIONS = {
+  LEGACY_V1: "legacy-v1",
+  V2: "v2",
+} as const;
+
+export type CalculationVersionResolution =
+  | {
+      status: "resolved";
+      version: "legacy-v1";
+      isLegacy: true;
+      isExplicit: boolean;
+    }
+  | {
+      status: "resolved";
+      version: "v2";
+      isLegacy: false;
+      isExplicit: true;
+    }
+  | {
+      status: "unsupported";
+      rawVersion: unknown;
+      isLegacy: false;
+    };
+
+/**
+ * Resolves the calculation version of an invoice from its snapshot data.
+ */
+export function resolveInvoiceCalculationVersion(
+  snapshotData: unknown
+): CalculationVersionResolution {
+  // 1. Complete absence of snapshot entirely (null or undefined)
+  if (snapshotData === null || snapshotData === undefined) {
+    return {
+      status: "resolved",
+      version: "legacy-v1",
+      isLegacy: true,
+      isExplicit: false,
+    };
+  }
+
+  // 2. Non-null snapshot of invalid structure (primitives: string, number, boolean; or array)
+  if (typeof snapshotData !== "object" || Array.isArray(snapshotData)) {
+    return {
+      status: "unsupported",
+      rawVersion: snapshotData,
+      isLegacy: false,
+    };
+  }
+
+  // 3. Valid record object
+  const record = snapshotData as Record<string, unknown>;
+  const raw = record.calculationVersion;
+
+  // Tag is absent from the record
+  if (raw === undefined) {
+    return {
+      status: "resolved",
+      version: "legacy-v1",
+      isLegacy: true,
+      isExplicit: false,
+    };
+  }
+
+  // Explicit legacy-v1
+  if (raw === CALCULATION_VERSIONS.LEGACY_V1) {
+    return {
+      status: "resolved",
+      version: "legacy-v1",
+      isLegacy: true,
+      isExplicit: true,
+    };
+  }
+
+  // Explicit reserved v2
+  if (raw === CALCULATION_VERSIONS.V2) {
+    return {
+      status: "resolved",
+      version: "v2",
+      isLegacy: false,
+      isExplicit: true,
+    };
+  }
+
+  // Null, empty string, whitespace-only, numbers, objects, arrays, or unknown strings
+  return {
+    status: "unsupported",
+    rawVersion: raw,
+    isLegacy: false,
+  };
+}
+
+/**
+ * Returns true if the invoice calculation version resolves to legacy-v1.
+ */
+export function isLegacyCalculationVersion(snapshotData: unknown): boolean {
+  const resolution = resolveInvoiceCalculationVersion(snapshotData);
+  return resolution.status === "resolved" && resolution.isLegacy;
+}
+
+/**
+ * Returns true if the invoice explicitly targets v2.
+ */
+export function isV2CalculationVersion(snapshotData: unknown): boolean {
+  const resolution = resolveInvoiceCalculationVersion(snapshotData);
+  return resolution.status === "resolved" && resolution.version === "v2";
+}
