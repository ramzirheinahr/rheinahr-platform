+  customPeriodEnd?: string;       // optional override (YYYY-MM-DD)
+  allowedQualifications?: readonly string[] | Set<string>;
+  allowBilledForInvoiceId?: string; // Phase 6: allows assignments already billed to this specific invoice
+};
