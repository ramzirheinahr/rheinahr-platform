# ─────────────────────────────────────────────────────────────
# RheinAhr Staffing Platform — environment template
# Copy to `.env` (Prisma + Next.js both read it) and fill in.
# NEVER commit the filled-in file. All PII storage must stay EU-region.
# ─────────────────────────────────────────────────────────────

# ── Database (Supabase — EU region / Frankfurt) ──
# Pooled connection (app runtime). Use the Supabase "Connection pooling" URI.
DATABASE_URL="postgresql://USER:PASSWORDي@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (Prisma migrations). Supabase "Direct connection" URI.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── Supabase Auth / Storage (EU region) ──
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"   # server-only, never expose

# ── App ──
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Email (Resend) ──
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="RheinAhr Dienstleistungen <info@rheinahr-gmbh.de>"

# ── SMS / WhatsApp (Twilio — German number) · Phase 2 ──
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ── Monitoring (Sentry — EU data residency) ──
SENTRY_DSN=""

# ── Web Push (VAPID) — mobile push notifications ──
# Generate once: npx web-push generate-vapid-keys
# Set all four in Vercel env too (public key must match on client + server).
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"          # server-only, never expose
VAPID_SUBJECT="mailto:info@rheinahr-gmbh.de"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key" # same as VAPID_PUBLIC_KEY

# ── Company Details (Dynamic Multi-Instance Setup) ──
NEXT_PUBLIC_COMPANY_NAME="RheinLand Personalmanagement und Fahrdienst GmbH"
NEXT_PUBLIC_COMPANY_SHORT_NAME="RheinLand"
NEXT_PUBLIC_COMPANY_EMAIL="info@rheinland-gmbh.de"
NEXT_PUBLIC_COMPANY_PHONE="+49 000 000000"
NEXT_PUBLIC_COMPANY_FAX="+49 000 000000"
NEXT_PUBLIC_COMPANY_MOBILE="+49 1512 6661733"
NEXT_PUBLIC_COMPANY_WEBSITE="www.rheinland-gmbh.de"
NEXT_PUBLIC_COMPANY_WEBSITE_URL="https://www.rheinland-gmbh.de"
NEXT_PUBLIC_COMPANY_ADDRESS_STREET="Theaterplatz 1"
NEXT_PUBLIC_COMPANY_ADDRESS_CITY="53177 Bonn"
NEXT_PUBLIC_COMPANY_CEO="Basem Aldanaf"
NEXT_PUBLIC_COMPANY_REGISTRY_COURT="Amtsgericht Bonn"
NEXT_PUBLIC_COMPANY_HRB="HRB 00000"
NEXT_PUBLIC_COMPANY_TAX_ID="206/5946/0975"
NEXT_PUBLIC_COMPANY_VAT_ID="DE459228538"
NEXT_PUBLIC_COMPANY_BANK_NAME="Finom Payments B.V."
NEXT_PUBLIC_COMPANY_IBAN="DE24 1001 8000 0966 6504 98"
NEXT_PUBLIC_COMPANY_BIC="FNOMDEB2XXX"
NEXT_PUBLIC_COMPANY_LOGO_URL="/RheinLand Logo.png"

